find_package(OpenGL REQUIRED)
find_package(glfw3 CONFIG REQUIRED)
find_package(imgui CONFIG QUIET)
if(TARGET imgui::imgui)
  # vcpkg: imgui[glfw-binding,opengl2-binding]. Backends are part of this target.
  set(IIMT_IMGUI_TARGET imgui::imgui)
else()
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(IIMT_IMGUI REQUIRED IMPORTED_TARGET imgui)
  set(IIMT_IMGUI_TARGET PkgConfig::IIMT_IMGUI)
endif()
pybind11_add_module(_viewer MODULE "${CMAKE_CURRENT_LIST_DIR}/viewer/viewer.cpp")
target_compile_features(_viewer PRIVATE cxx_std_17)
target_link_libraries(_viewer PRIVATE glfw OpenGL::GL ${IIMT_IMGUI_TARGET})
if(MSVC)
  target_compile_definitions(_viewer PRIVATE NOMINMAX)
  target_compile_options(_viewer PRIVATE /W4)
else()
  target_compile_options(_viewer PRIVATE -Wall -Wextra -Wpedantic)
endif()
install(TARGETS _viewer LIBRARY DESTINATION iimt RUNTIME DESTINATION iimt)
